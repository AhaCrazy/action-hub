{
  "name": "action-hub-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the harness-agnostic Action Hub core and its DSH/Pi adapters.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test --workspace action-hub",
    "test:dsh": "npm run test --workspace dsh-action-hub",
    "test:pi": "npm run test --workspace pi-action-hub",
    "build": "npm run build --workspace dsh-action-hub"
  }
}
