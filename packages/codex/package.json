{
  "name": "codex-action-hub",
  "version": "0.1.0",
  "type": "module",
  "description": "Action Hub 的 Codex 适配器：把共享 Action 同步为 Codex 原生 Agent Skills。",
  "keywords": [
    "codex",
    "codex-cli",
    "action-hub",
    "agent-skills",
    "skills"
  ],
  "license": "MIT",
  "author": "AhaCrazy",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "action-hub-codex": "./bin/action-hub-codex.js"
  },
  "main": "./dist/action-hub-codex.js",
  "exports": {
    ".": "./dist/action-hub-codex.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "builtin-actions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node tests/sync.test.mjs && node --check src/sync.js && node --check src/cli.js && node --check src/builtins.js && node --check bin/action-hub-codex.js"
  },
  "devDependencies": {
    "action-hub": "file:../core"
  }
}
