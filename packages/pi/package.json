{
  "name": "pi-action-hub",
  "version": "0.1.0",
  "type": "module",
  "description": "Action Hub 的 Pi 适配器：原生 TUI 面板、编辑器插入和标准 Agent Skill 资源发现。",
  "keywords": [
    "pi-package",
    "pi",
    "action-hub",
    "skills",
    "tui"
  ],
  "license": "MIT",
  "author": "AhaCrazy",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/action-hub.js",
  "exports": {
    ".": "./dist/action-hub.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "builtin-actions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node tests/catalog.test.mjs && node tests/management.test.mjs && node tests/project-scopes.test.mjs && node --check extensions/action-hub.js && node --check src/palette.js"
  },
  "pi": {
    "extensions": [
      "./dist/action-hub.js"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/action-hub.js"
    ]
  },
  "devDependencies": {
    "action-hub": "file:../core"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*"
  }
}
