{
  "name": "dsh-action-hub",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek Harness 适配器：基于通用 action-hub 核心，提供原生 Alt+A 面板、composer 插入、项目范围和 Skill provider。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "action-hub",
    "adapter",
    "skill",
    "palette",
    "cordis"
  ],
  "license": "MIT",
  "author": "AhaCrazy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhaCrazy/action-hub.git",
    "directory": "packages/dsh"
  },
  "homepage": "https://github.com/AhaCrazy/action-hub/tree/main/packages/dsh",
  "bugs": {
    "url": "https://github.com/AhaCrazy/action-hub/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "icon": "./icon.svg",
  "main": "./dist/index.js",
  "meta": {
    "title": "Action Hub",
    "description": "DSH 版 Action Hub：标准 Skill、Command、分组和项目范围。"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build": "npm run build:client && npm run build:host",
    "dev": "node scripts/watch-client.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node tests/builtins.test.mjs && node tests/provider.test.mjs && node tests/client.test.mjs && node tests/host.test.mjs && node tests/seed.test.mjs && node tests/project-scopes.test.mjs && node tests/state.test.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/**",
    "screenshots.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "action-hub": "file:../core"
  }
}
